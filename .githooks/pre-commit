#!/bin/bash
# Pre-commit hook for the news-reader plugin.
# Runs the full local verify pass (scripts/verify.sh) when any plugin source is
# staged. Skips when nothing is staged (e.g. empty commit) so it never blocks.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Nothing staged -> nothing to verify.
if git diff --cached --quiet; then
  exit 0
fi

# Only run against the plugin tree; if only unrelated files are staged we still
# run (cheap) but guard against running outside this repo.
exec "$REPO_ROOT/scripts/verify.sh"
